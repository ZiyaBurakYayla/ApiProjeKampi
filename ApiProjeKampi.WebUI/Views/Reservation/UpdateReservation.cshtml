@model GetReservationByIdDto
@{
    ViewData["Title"] = "UpdateReservation";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Rezervasyon Güncelle</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <input type="hidden" asp-for="ReservationId" />
                                <label>Misafir Ad-Soyad</label>
                                <input type="text" asp-for="NameSurname" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Mail Adres</label>
                                <input type="text" asp-for="Email" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Tel No</label>
                                <input type="tel" asp-for="PhoneNo" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Tarih</label>
                                <input type="date" asp-for="ReservationDate" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Saat</label>
                                <input type="time" asp-for="ReservationTime" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Kişi Sayısı</label>
                                <input type="number" asp-for="CountOfPeople" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Meesaj</label>
                                <input type="text" asp-for="Message" class="form-control" placeholder="Kategori adını giriniz..." required>
                                <label>Durum</label>
                                <input type="text" asp-for="ReservationStatus" class="form-control" readonly>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Rezervasyonu Güncelle
                                </button>
                                <a href="/Reservation/ReservationList/" class="btn btn-secondary">
                                    Vazgeç / Listeye Dön
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>