@model GetByIdMessageDto
@{
    ViewData["Title"] = "Mesaj Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Mesaj Detaylarını Güncelle</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="MessageId" />
                            <input type="hidden" asp-for="SendDate" />

                            <div class="form-group">
                                <label>Gönderen Adı Soyadı</label>
                                <input type="text" asp-for="NameSurname" class="form-control" placeholder="Ad Soyad giriniz..." required>
                            </div>

                            <div class="form-group">
                                <label>E-posta Adresi</label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="E-posta giriniz..." required>
                            </div>

                            <div class="form-group">
                                <label>Konu</label>
                                <input type="text" asp-for="Subject" class="form-control" placeholder="Konu giriniz..." required>
                            </div>

                            <div class="form-group">
                                <label>Mesaj İçeriği</label>
                                <textarea asp-for="MessageContent" class="form-control" rows="5" placeholder="Mesaj içeriğini giriniz..." required></textarea>
                            </div>

                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" asp-for="IsRead" class="custom-control-input" id="isReadCheck">
                                    <label class="custom-control-label" for="isReadCheck">Okundu Olarak İşaretle</label>
                                </div>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Değişiklikleri Kaydet
                                </button>
                                <a href="/Message/MessageList/" class="btn btn-secondary">
                                    Vazgeç / Listeye Dön
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>