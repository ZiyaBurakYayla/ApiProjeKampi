@model List<ApiProjeKampi.WebUI.Dtos.ServiceDtos.ResultServiceDto>
<section id="why-us" class="why-us section light-background">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="why-box gy-4">
                    <h3>Neden Yummy</h3>
                    <p>
                        Yummy, taptaze malzemelerle hazırlanan eşsiz tarifleriyle lezzeti ve kaliteyi bir araya getirir. Her lokmada özenle hazırlanan yemeklerimiz, damak tadınıza hitap eder.
                        Deneyimli şeflerimizle, sofralarınıza mutluluk getiriyoruz.
                        <div class="text-center">
                            <a href="#contact" class="more-btn"><span>Rezervasyon Yapın</span> <i class="bi bi-chevron-right"></i></a>
                        </div>
                </div>
            </div>

            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">
                    @foreach (var item in Model.Take(3))
                    {
                        <div class="col-xl-4">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="@item.IconUrl"></i>
                                <h4>@item.Tite</h4>
                                <p>@item.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</section>