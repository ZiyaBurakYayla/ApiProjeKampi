@model List<ResultProductDto>

<div class="tab-content" data-aos="fade-up" data-aos-delay="200">

    <!-- Tüm Menü -->
    <div class="tab-pane fade active show" id="menu-all">
        <div class="tab-header text-center">
            <p>Menü</p>
            <h3>Tüm Lezzetler</h3>
        </div>

        <div class="row gy-5" id="menuProductsRow">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 menu-item">
                    <a href="@item.ImageUrl" class="glightbox">
                        <img src="@item.ImageUrl" class="menu-img img-fluid" alt="" style="height:250px; width:500px;">
                    </a>
                    <h4>@item.ProductName</h4>
                    <p class="ingredients">@item.Description</p>
                    <p class="price">@item.Price ₺</p>
                </div>
            }
        </div>

        <nav class="mt-5" aria-label="Menü sayfalama">
            <ul class="pagination justify-content-center" id="menuPagination"></ul>
        </nav>
    </div>
    @foreach (var categoryId in Model.Select(x => x.CategoryId).Distinct())
    {
        <div class="tab-pane fade" id="menu-@categoryId">
            <div class="tab-header text-center">
                <p>Menü</p>
                <h3>@Model.First(x => x.CategoryId == categoryId).CategoryName</h3>
            </div>

            <div class="row gy-5">
                @foreach (var item in Model.Where(x => x.CategoryId == categoryId))
                {
                    <div class="col-lg-4 menu-item">
                        <a href="@item.ImageUrl" class="glightbox">
                            <img src="@item.ImageUrl" class="menu-img img-fluid" alt="" style="height:250px; width:500px;">
                        </a>
                        <h4>@item.ProductName</h4>
                        <p class="ingredients">@item.Description</p>
                        <p class="price">@item.Price ₺</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    #menuPagination .page-link {
        color: var(--accent-color, #ce1212);
        cursor: pointer;
    }

    #menuPagination .page-item.active .page-link {
        background-color: var(--accent-color, #ce1212);
        border-color: var(--accent-color, #ce1212);
        color: #fff;
    }

    #menuPagination .page-item.disabled .page-link {
        color: #adb5bd;
    }
</style>

<script>
    (function () {
        function initMenuPagination() {
            var row = document.getElementById('menuProductsRow');
            var pager = document.getElementById('menuPagination');
            if (!row || !pager) return;

            var items = Array.prototype.slice.call(row.querySelectorAll('.menu-item'));
            var perPage = 6;
            var pageCount = Math.ceil(items.length / perPage);
            var current = 1;

            function showPage(p) {
                if (p < 1) p = 1;
                if (p > pageCount) p = pageCount;
                current = p;
                items.forEach(function (el, i) {
                    var inPage = i >= (p - 1) * perPage && i < p * perPage;
                    el.style.display = inPage ? '' : 'none';
                });
                renderPager();
                if (window.AOS && typeof window.AOS.refresh === 'function') window.AOS.refresh();
            }

            function makeBtn(label, page, opts) {
                opts = opts || {};
                var li = document.createElement('li');
                li.className = 'page-item' + (opts.active ? ' active' : '') + (opts.disabled ? ' disabled' : '');
                var a = document.createElement('a');
                a.className = 'page-link';
                a.href = 'javascript:void(0)';
                a.innerHTML = label;
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (opts.disabled || opts.active) return;
                    showPage(page);
                });
                li.appendChild(a);
                return li;
            }

            function renderPager() {
                pager.innerHTML = '';
                if (pageCount <= 1) return;
                pager.appendChild(makeBtn('&laquo;', current - 1, { disabled: current === 1 }));
                for (var p = 1; p <= pageCount; p++) {
                    pager.appendChild(makeBtn(String(p), p, { active: p === current }));
                }
                pager.appendChild(makeBtn('&raquo;', current + 1, { disabled: current === pageCount }));
            }

            showPage(1);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMenuPagination);
        } else {
            initMenuPagination();
        }
    })();
</script>
