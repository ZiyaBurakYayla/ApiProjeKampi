@model GetContactByIdDto
@{
    ViewData["Title"] = "İletişim Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>İletişim Bilgilerini Güncelle</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="ContactId" />

                            <div class="form-group">
                                <label>Harita Konumu</label>
                                <input type="text" asp-for="MapLocation" class="form-control" required>
                            </div>

                            <div class="form-group">
                                <label>Adres</label>
                                <textarea asp-for="Address" class="form-control" rows="2" required></textarea>
                            </div>

                            <div class="form-group">
                                <label>Telefon Numarası</label>
                                <input type="text" asp-for="PhoneNo" class="form-control" required>
                            </div>

                            <div class="form-group">
                                <label>E-posta Adresi</label>
                                <input type="email" asp-for="Email" class="form-control" required>
                            </div>

                            <div class="form-group">
                                <label>Açılış Saatleri</label>
                                <input type="text" asp-for="OpenHours" class="form-control" required>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Değişiklikleri Kaydet
                                </button>
                                <a href="/Contact/ContactList/" class="btn btn-secondary">Vazgeç</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>