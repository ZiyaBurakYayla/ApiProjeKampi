@model CreateContactDto
@{
    ViewData["Title"] = "İletişim Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Yeni İletişim Bilgisi Oluştur</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label>Harita Konumu (Iframe Linki)</label>
                                <input type="text" asp-for="MapLocation" class="form-control" placeholder="Google Maps linkini giriniz..." required>
                            </div>
                            <div class="form-group">
                                <label>Adres</label>
                                <input type="text" asp-for="Address" class="form-control" placeholder="Açık adresi giriniz..." required>
                            </div>
                            <div class="form-group">
                                <label>Telefon Numarası</label>
                                <input type="text" asp-for="PhoneNo" class="form-control" placeholder="05XX XXX XX XX" required>
                            </div>
                            <div class="form-group">
                                <label>E-posta Adresi</label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="ornek@mail.com" required>
                            </div>
                            <div class="form-group">
                                <label>Açılış Saatleri</label>
                                <input type="text" asp-for="OpenHours" class="form-control" placeholder="Hergün: 09:00 - 22:00" required>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> İletişimi Kaydet
                                </button>
                                <a href="/Contact/ContactList/" class="btn btn-secondary">Vazgeç</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>