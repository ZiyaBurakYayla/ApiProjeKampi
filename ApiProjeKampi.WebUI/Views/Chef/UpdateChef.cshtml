@model GetChefByIdDto
@{
    ViewData["Title"] = "UpdateChef";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Şef Bilgilerini Güncelle</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <input type="hidden" asp-for="ChefId" />
                            <div class="form-group">
                                <label>Şef Adı Soyadı</label>
                                <input type="text" asp-for="NameSurname" class="form-control" required>

                                <label class="mt-2">Unvan / Pozisyon</label>
                                <input type="text" asp-for="Title" class="form-control" required>

                                <label class="mt-2">Kısa Biyografi</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>

                                <label class="mt-2">Fotoğraf URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control">
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Bilgileri Güncelle
                                </button>
                                <a href="/Chef/ChefList/" class="btn btn-secondary">Listeye Dön</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>