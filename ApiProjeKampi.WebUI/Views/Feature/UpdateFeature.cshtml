@model GetFeatureByIdDto
@{
    ViewData["Title"] = "UpdateFeature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Öne Çıkan Alan Güncelle</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <input type="hidden" asp-for="FeatureId" />

                                <label>Ana Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Ana başlığı giriniz..." required>

                                <label class="mt-2">Alt Başlık</label>
                                <input type="text" asp-for="SubTitle" class="form-control" placeholder="Alt başlığı giriniz..." required>

                                <label class="mt-2">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" placeholder="Kısa açıklama giriniz..." rows="3" required></textarea>

                                <label class="mt-2">Video URL</label>
                                <input type="text" asp-for="VideoUrl" class="form-control" placeholder="Video bağlantısını giriniz..." required>

                                <label class="mt-2">Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Görsel bağlantısını giriniz..." required>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Değişiklikleri Kaydet
                                </button>
                                <a href="/Feature/FeatureList/" class="btn btn-secondary">
                                    Vazgeç / Listeye Dön
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>