@using ApiProjeKampi.WebUI.Dtos.GroupReservationDtos
@model List<ResultGroupReservationDto>
@{
    ViewData["Title"] = "GroupReservationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Grup Rezervasyonları</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Grup Başlığı</th>
                                        <th scope="col">Yetkili Kişi</th>
                                        <th scope="col">E-posta</th>
                                        <th scope="col">Rezervasyon Tarihi</th>
                                        <th scope="col">Son İşlem</th>
                                        <th scope="col">Kişi</th>
                                        <th scope="col">Öncelik</th>
                                        <th scope="col">Durum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.GroupTitle</td>
                                            <td>@item.ResponsibleCustomerName</td>
                                            <td>@item.Email</td>
                                            <td>@item.ReservationDate.ToString("dd.MM.yyyy")</td>
                                            <td>@item.LastProcessDate.ToString("dd.MM.yyyy")</td>
                                            <td>@item.PersonCount Kişi</td>
                                            <td>@item.Priority</td>
                                            <td>@item.ReservationStatus</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
