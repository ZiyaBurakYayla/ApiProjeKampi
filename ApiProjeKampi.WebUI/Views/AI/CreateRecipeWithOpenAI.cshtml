
@{
    ViewData["Title"] = "CreateRecipeWithOpenAI";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Open AI ile Yapay Zeka destekli tarif Oluştur</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label>Elinizdeki malzemeler ve anahtar kelimeler</label>
                                <input type="text" name="prompt" class="form-control" placeholder="Elinizdeki malzemeler ve anahtar kelimeleri giriniz..." required>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Tarifi Oluştur
                                </button>
                            </div>
                        </form>
                        <br /><br />
                        @if(ViewBag.recipe != null)
                        {
                            <hr />
                            <h5>Oluşturulan AI yemek tarifi önerisi</h5>
                            @Html.Raw(ViewBag.recipe.ToString())
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

