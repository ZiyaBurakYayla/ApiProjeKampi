@model CreateEventDto
@{
    ViewData["Title"] = "AddEvent";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Yeni Etkinlik Oluştur</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label>Etkinlik Başlığı</label>
                                <input type="text" asp-for="Title" class="form-control" required>

                                <label class="mt-2">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>

                                <label class="mt-2">Tarih Bilgisi</label>
                                <input type="text" asp-for="EventDate" class="form-control" placeholder="Örn: 20 Mayıs 2026">

                                <label class="mt-2">Fiyat</label>
                                <input type="number" step="0.01" asp-for="Price" class="form-control">

                                <label class="mt-2">Görsel URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control">
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Etkinliği Kaydet
                                </button>
                                <a href="/Event/EventList/" class="btn btn-secondary">Vazgeç</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>